@model IEnumerable<GrowQuest.Models.Mission>

@{
    ViewData["Title"] = "Mission History";

    int totalMissions =
        ViewBag.TotalMissions ?? 0;

    int completedMissions =
        ViewBag.CompletedMissions ?? 0;
}


<div class="container py-5">

    <!-- HEADER -->
    <div class="d-flex
        flex-column
        flex-md-row
        justify-content-between
        align-items-md-center
        gap-3
        mb-4">

        <div>

            <h1 class="fw-bold mb-1">
                📚 Mission History
            </h1>

            <p class="text-muted mb-0">
                Look back at missions you've accomplished.
            </p>

        </div>


        <a asp-action="Index"
           class="btn btn-outline-success">

            ← Dashboard

        </a>

    </div>



    <!-- SUMMARY -->
    <div class="row mb-5">

        <div class="col-md-6">

            <div class="card
                shadow-sm
                border-0">

                <div class="card-body p-4">

                    <div class="text-muted small">
                        Completed History
                    </div>

                    <div class="fs-2
                        fw-bold
                        text-success">

                        @completedMissions

                    </div>

                    <div class="small text-muted">
                        ✅ Past missions accomplished
                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- HISTORY -->
    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0">

            <div class="card-body
                py-5
                text-center">

                <div style="font-size: 55px;">
                    📖
                </div>

                <h4 class="fw-bold mt-3">
                    No completed history yet
                </h4>

                <p class="text-muted">
                    Completed missions will appear here
                    after their scheduled day has passed.
                </p>

                <a asp-action="Index"
                   class="btn btn-success">

                    Go to Dashboard

                </a>

            </div>

        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table
                        table-hover
                        align-middle
                        mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Mission
                                </th>

                                <th>
                                    Difficulty
                                </th>

                                <th>
                                    Mission Date
                                </th>

                                <th>
                                    Completed
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end pe-4">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                DateTime missionDate =
                                    (item.MissionDate ??
                                     item.CreatedDate).Date;

                                <tr>

                                    <!-- Mission -->
                                    <td class="ps-4">

                                        <strong>
                                            @item.Title
                                        </strong>

                                        @if (!string.IsNullOrWhiteSpace(
                                            item.Description))
                                        {
                                            <div class="small text-muted">
                                                @item.Description
                                            </div>
                                        }

                                    </td>


                                    <!-- Difficulty -->
                                    <td>

                                        @if (item.Difficulty == "Easy")
                                        {
                                            <span class="badge bg-success">
                                                Easy +10 XP
                                            </span>
                                        }
                                        else if (item.Difficulty == "Medium")
                                        {
                                            <span class="badge
                                                bg-warning
                                                text-dark">
                                                Medium +20 XP
                                            </span>
                                        }
                                        else if (item.Difficulty == "Hard")
                                        {
                                            <span class="badge bg-danger">
                                                Hard +30 XP
                                            </span>
                                        }

                                    </td>


                                    <!-- Mission Date -->
                                    <td>

                                        @missionDate.ToString(
                                            "MMM dd, yyyy")

                                    </td>


                                    <!-- Completed -->
                                    <td>

                                        @if (item.CompletedDate.HasValue)
                                        {
                                            <div>

                                                @item.CompletedDate.Value
                                                .ToString("MMM dd, yyyy")

                                            </div>

                                            <div class="small text-muted">

                                                @item.CompletedDate.Value
                                                .ToString("h:mm tt")

                                            </div>
                                        }

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        <span class="text-success
                                            fw-semibold">

                                            ✅ Completed

                                        </span>

                                    </td>


                                    <!-- Actions -->
                                    <td class="text-end pe-4">

                                        <a asp-action="Details"
                                           asp-route-id="@item.MissionId"
                                           class="btn
                                            btn-outline-secondary
                                            btn-sm">

                                            Details

                                        </a>


                                        <a asp-action="Delete"
                                           asp-route-id="@item.MissionId"
                                           class="btn
                                            btn-outline-danger
                                            btn-sm">

                                            Delete

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>