@model IEnumerable<GrowQuest.Models.Mission>

@{
    ViewData["Title"] = "Today's Missions";

    int progressPoints = ViewBag.ProgressPoints ?? 0;
    int currentStage = ViewBag.CurrentStage ?? 1;
    string growthName = ViewBag.GrowthName ?? "GrowQuest Plant";

    int totalToday = ViewBag.TotalToday ?? 0;
    int completedToday = ViewBag.CompletedToday ?? 0;
    int remainingToday = ViewBag.RemainingToday ?? 0;

    string plantEmoji = "🌱";
    string stageName = "Seed";

    int nextStagePoints = 30;
    int previousStagePoints = 0;

    if (currentStage == 2)
    {
        plantEmoji = "🌿";
        stageName = "Small Plant";

        previousStagePoints = 30;
        nextStagePoints = 70;
    }
    else if (currentStage == 3)
    {
        plantEmoji = "🪴";
        stageName = "Growing Plant";

        previousStagePoints = 70;
        nextStagePoints = 120;
    }
    else if (currentStage >= 4)
    {
        plantEmoji = "🌳";
        stageName = "Fully Grown";

        previousStagePoints = 120;
        nextStagePoints = 120;
    }

    int progressPercent = 100;

    if (currentStage < 4)
    {
        int pointsInStage =
            progressPoints - previousStagePoints;

        int pointsNeeded =
            nextStagePoints - previousStagePoints;

        progressPercent =
            (int)((double)pointsInStage /
            pointsNeeded * 100);

        if (progressPercent < 0)
        {
            progressPercent = 0;
        }

        if (progressPercent > 100)
        {
            progressPercent = 100;
        }
    }

    int dailyPercent = 0;

    if (totalToday > 0)
    {
        dailyPercent =
            (int)((double)completedToday /
            totalToday * 100);
    }
}

<div class="container py-5">

    <!-- =========================
         HEADER
         ========================= -->

    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center
        gap-3 mb-4">

        <div>

            <h1 class="fw-bold mb-1">
                🌱 GrowQuest
            </h1>

            <p class="text-muted mb-0">
                Complete today's missions and grow your plant.
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-success btn-lg px-4">

            + New Mission

        </a>

    </div>


    <!-- =========================
         STAT CARDS
         ========================= -->

    <div class="row g-3 mb-4">

        <div class="col-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="text-muted small mb-1">
                        Today's Missions
                    </div>

                    <div class="fs-2 fw-bold">
                        @totalToday
                    </div>

                    <div class="small text-muted">
                        📋 Planned today
                    </div>

                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="text-muted small mb-1">
                        Completed
                    </div>

                    <div class="fs-2 fw-bold text-success">
                        @completedToday
                    </div>

                    <div class="small text-muted">
                        ✅ Finished today
                    </div>

                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="text-muted small mb-1">
                        Remaining
                    </div>

                    <div class="fs-2 fw-bold">
                        @remainingToday
                    </div>

                    <div class="small text-muted">
                        ⏳ Still to complete
                    </div>

                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="text-muted small mb-1">
                        Total XP
                    </div>

                    <div class="fs-2 fw-bold text-success">
                        @progressPoints
                    </div>

                    <div class="small text-muted">
                        ⭐ Lifetime progress
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         PLANT CARD
         ========================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body p-4">

            <div class="row align-items-center">

                <div class="col-md-3 text-center">

                    <div style="font-size: 100px;">
                        @plantEmoji
                    </div>

                </div>


                <div class="col-md-9">

                    <h2 class="fw-bold mb-1">
                        @growthName
                    </h2>

                    <h5 class="mb-3">
                        Stage @currentStage - @stageName
                    </h5>

                    <div class="d-flex
                        justify-content-between
                        mb-2">

                        <strong>
                            @progressPoints XP
                        </strong>

                        @if (currentStage < 4)
                        {
                            <span class="text-muted">

                                Next:
                                @nextStagePoints XP

                            </span>
                        }

                    </div>


                    <div class="progress"
                         style="height: 24px;">

                        <div class="progress-bar bg-success"
                             role="progressbar"
                             style="width: @progressPercent%;">

                            @progressPercent%

                        </div>

                    </div>


                    @if (currentStage < 4)
                    {
                        <p class="text-muted mt-2 mb-0">

                            @(nextStagePoints - progressPoints)
                            XP until your plant reaches the next stage.

                        </p>
                    }
                    else
                    {
                        <p class="text-success fw-semibold mt-2 mb-0">

                            🌟 Your plant is fully grown!

                        </p>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         DAILY PROGRESS
         ========================= -->

    <div class="card shadow-sm border-0 mb-5">

        <div class="card-body p-4">

            <div class="d-flex
                justify-content-between
                align-items-center
                mb-2">

                <div>

                    <h5 class="fw-bold mb-1">
                        Today's Progress
                    </h5>

                    <span class="text-muted">

                        @completedToday of
                        @totalToday missions completed

                    </span>

                </div>

                <span class="badge bg-success fs-6">

                    @dailyPercent%

                </span>

            </div>


            <div class="progress"
                 style="height: 12px;">

                <div class="progress-bar bg-success"
                     role="progressbar"
                     style="width: @dailyPercent%;">
                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         MISSIONS
         ========================= -->

    <div class="d-flex
        justify-content-between
        align-items-center
        mb-3">

        <div>

            <h2 class="fw-bold mb-1">
                Today's Missions
            </h2>

            <p class="text-muted mb-0">
                @DateTime.Today.ToString("dddd, MMMM dd")
            </p>

        </div>

    </div>


    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0">

            <div class="card-body
                text-center
                py-5">

                <div style="font-size: 55px;">
                    🌱
                </div>

                <h4 class="fw-bold mt-3">
                    No missions yet
                </h4>

                <p class="text-muted">

                    Start your day by creating your first mission.

                </p>

                <a asp-action="Create"
                   class="btn btn-success">

                    + Create Mission

                </a>

            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-6">

                    <div class="card shadow-sm
                        border-0 h-100">

                        <div class="card-body p-4">


                            <!-- Title + difficulty -->

                            <div class="d-flex
                                justify-content-between
                                align-items-start
                                gap-3">

                                <h4 class="card-title mb-2">

                                    @if (item.IsCompleted)
                                    {
                                        <span>
                                            ✅
                                        </span>
                                    }

                                    @item.Title

                                </h4>


                                @if (item.Difficulty == "Easy")
                                {
                                    <span class="badge bg-success">

                                        Easy +10 XP

                                    </span>
                                }
                                else if (item.Difficulty == "Medium")
                                {
                                    <span class="badge bg-warning text-dark">

                                        Medium +20 XP

                                    </span>
                                }
                                else if (item.Difficulty == "Hard")
                                {
                                    <span class="badge bg-danger">

                                        Hard +30 XP

                                    </span>
                                }

                            </div>


                            <!-- Description -->
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <p class="text-muted mt-2">

                                    @item.Description

                                </p>
                            }


                            <!-- Created time -->

                            <p class="small text-muted">

                                Created at
                                @item.CreatedDate.ToString("h:mm tt")

                            </p>


                            <!-- Completion -->
                            @if (item.IsCompleted)
                            {
                                <div class="alert alert-success py-2">

                                    <strong>
                                        Mission Completed
                                    </strong>

                                    @if (item.CompletedDate.HasValue)
                                    {
                                        <br />

                                        <small>

                                            Completed at
                                            @item.CompletedDate.Value
                                            .ToString("h:mm tt")

                                        </small>
                                    }

                                </div>
                            }
                            else
                            {
                                <form asp-action="Complete"
                                      method="post"
                                      class="mb-3">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.MissionId" />

                                    <button type="submit"
                                            class="btn btn-success">

                                        ✓ Complete Mission

                                    </button>

                                </form>
                            }


                            <!-- Actions -->

                            <div class="d-flex gap-2">

                                @if (!item.IsCompleted)
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.MissionId"
                                       class="btn btn-outline-primary btn-sm">

                                        Edit

                                    </a>
                                }

                                <a asp-action="Details"
                                   asp-route-id="@item.MissionId"
                                   class="btn btn-outline-secondary btn-sm">

                                    Details

                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.MissionId"
                                   class="btn btn-outline-danger btn-sm">

                                    Delete

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>