@model IEnumerable<GrowQuest.Models.Mission>

@{
    ViewData["Title"] = "Today's Missions";

    int progressPoints =
        ViewBag.ProgressPoints ?? 0;

    int currentStage =
        ViewBag.CurrentStage ?? 1;

    string growthName =
        ViewBag.GrowthName ?? "GrowQuest Plant";

    int totalToday =
        ViewBag.TotalToday ?? 0;

    int completedToday =
        ViewBag.CompletedToday ?? 0;

    int remainingToday =
        ViewBag.RemainingToday ?? 0;


    // =========================================
    // GROWTH LEVEL INFORMATION
    // =========================================

    string plantEmoji = "🌰";
    string stageName = "Seed";

    int currentLevelMinimum = 0;
    int nextStagePoints = 30;


    if (currentStage == 2)
    {
        plantEmoji = "🌱";
        stageName = "Sprout";

        currentLevelMinimum = 30;
        nextStagePoints = 70;
    }
    else if (currentStage == 3)
    {
        plantEmoji = "🌿";
        stageName = "Seedling";

        currentLevelMinimum = 70;
        nextStagePoints = 120;
    }
    else if (currentStage == 4)
    {
        plantEmoji = "🪴";
        stageName = "Young Plant";

        currentLevelMinimum = 120;
        nextStagePoints = 200;
    }
    else if (currentStage == 5)
    {
        plantEmoji = "🌷";
        stageName = "Budding Plant";

        currentLevelMinimum = 200;
        nextStagePoints = 300;
    }
    else if (currentStage == 6)
    {
        plantEmoji = "🌸";
        stageName = "Flowering Plant";

        currentLevelMinimum = 300;
        nextStagePoints = 450;
    }
    else if (currentStage == 7)
    {
        plantEmoji = "🌳";
        stageName = "Small Tree";

        currentLevelMinimum = 450;
        nextStagePoints = 650;
    }
    else if (currentStage == 8)
    {
        plantEmoji = "🌲";
        stageName = "Mature Tree";

        currentLevelMinimum = 650;
        nextStagePoints = 900;
    }
    else if (currentStage == 9)
    {
        plantEmoji = "✨🌳";
        stageName = "Ancient Tree";

        currentLevelMinimum = 900;
        nextStagePoints = 1200;
    }
    else if (currentStage >= 10)
    {
        plantEmoji = "🌟🌳";
        stageName = "Legendary Tree";

        currentLevelMinimum = 1200;
        nextStagePoints = 1200;
    }


    // =========================================
    // LEVEL PROGRESS
    // =========================================

    int progressPercent = 100;

    if (currentStage < 10)
    {
        int xpInsideCurrentLevel =
            progressPoints - currentLevelMinimum;

        int xpRequiredForLevel =
            nextStagePoints - currentLevelMinimum;

        progressPercent =
            (int)(
                (double)xpInsideCurrentLevel /
                xpRequiredForLevel *
                100
            );

        if (progressPercent < 0)
        {
            progressPercent = 0;
        }

        if (progressPercent > 100)
        {
            progressPercent = 100;
        }
    }


    // =========================================
    // DAILY PROGRESS
    // =========================================

    int dailyPercent = 0;

    if (totalToday > 0)
    {
        dailyPercent =
            (int)(
                (double)completedToday /
                totalToday *
                100
            );
    }
}


<div class="container py-5">


    <!-- =====================================
         HEADER
         ===================================== -->

    <div class="d-flex
        flex-column
        flex-md-row
        justify-content-between
        align-items-md-center
        gap-3
        mb-4">

        <div>

            <h1 class="fw-bold mb-1">
                🌱 GrowQuest
            </h1>

            <p class="text-muted mb-0">
                Complete today's missions and grow your plant.
            </p>

        </div>


        <a asp-action="Create"
           class="btn btn-success btn-lg px-4">

            + New Mission

        </a>

    </div>



    <!-- =====================================
         DASHBOARD STATS
         ===================================== -->

    <div class="row g-3 mb-4">


        <!-- Today's Missions -->
        <div class="col-6 col-lg-3">

            <div class="card
                shadow-sm
                border-0
                h-100">

                <div class="card-body p-4">

                    <div class="text-muted small mb-1">
                        Today's Missions
                    </div>

                    <div class="fs-2 fw-bold">
                        @totalToday
                    </div>

                    <div class="small text-muted">
                        📋 Planned today
                    </div>

                </div>

            </div>

        </div>


        <!-- Completed -->
        <div class="col-6 col-lg-3">

            <div class="card
                shadow-sm
                border-0
                h-100">

                <div class="card-body p-4">

                    <div class="text-muted small mb-1">
                        Completed
                    </div>

                    <div class="fs-2
                        fw-bold
                        text-success">

                        @completedToday

                    </div>

                    <div class="small text-muted">
                        ✅ Finished today
                    </div>

                </div>

            </div>

        </div>


        <!-- Remaining -->
        <div class="col-6 col-lg-3">

            <div class="card
                shadow-sm
                border-0
                h-100">

                <div class="card-body p-4">

                    <div class="text-muted small mb-1">
                        Remaining
                    </div>

                    <div class="fs-2 fw-bold">
                        @remainingToday
                    </div>

                    <div class="small text-muted">
                        ⏳ Still to complete
                    </div>

                </div>

            </div>

        </div>


        <!-- XP -->
        <div class="col-6 col-lg-3">

            <div class="card
                shadow-sm
                border-0
                h-100">

                <div class="card-body p-4">

                    <div class="text-muted small mb-1">
                        Total XP
                    </div>

                    <div class="fs-2
                        fw-bold
                        text-success">

                        @progressPoints

                    </div>

                    <div class="small text-muted">
                        ⭐ Lifetime progress
                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- =====================================
         GROWTH CARD
         ===================================== -->

    <div class="card
        shadow-sm
        border-0
        mb-4">

        <div class="card-body p-4 p-md-5">


            <div class="row
                align-items-center">


                <!-- Plant -->
                <div class="col-md-3
                    text-center
                    mb-4
                    mb-md-0">

                    <div style="font-size: 100px;
                        line-height: 1.2;">

                        @plantEmoji

                    </div>

                </div>


                <!-- Plant Info -->
                <div class="col-md-9">


                    <div class="d-flex
                        flex-column
                        flex-md-row
                        justify-content-between
                        gap-2">


                        <div>

                            <h2 class="fw-bold mb-1">
                                @growthName
                            </h2>

                            <h5 class="text-muted">

                                Level @currentStage
                                of 10

                                <span class="mx-1">
                                    •
                                </span>

                                @stageName

                            </h5>

                        </div>


                        <div>

                            <span class="badge
                                bg-success
                                fs-6
                                px-3
                                py-2">

                                ⭐ @progressPoints XP

                            </span>

                        </div>


                    </div>


                    <hr />


                    @if (currentStage < 10)
                    {

                        <div class="d-flex
                            justify-content-between
                            mb-2">

                            <strong>
                                Level @currentStage Progress
                            </strong>

                            <span class="text-muted">

                                @progressPoints /
                                @nextStagePoints XP

                            </span>

                        </div>


                        <div class="progress"
                             style="height: 24px;">

                            <div class="progress-bar
                                bg-success"
                                 role="progressbar"
                                 style="width: @progressPercent%;">

                                @progressPercent%

                            </div>

                        </div>


                        <div class="d-flex
                            justify-content-between
                            mt-2">

                            <span class="text-muted">

                                @stageName

                            </span>

                            <span class="text-success
                                fw-semibold">

                                @(nextStagePoints - progressPoints)
                                XP to Level @(currentStage + 1)

                            </span>

                        </div>

                    }
                    else
                    {

                        <div class="alert
                            alert-success
                            mb-0">

                            <h5 class="fw-bold">
                                🌟 Maximum Growth Reached!
                            </h5>

                            <p class="mb-0">

                                Your plant has reached
                                Legendary Tree status.

                                You can still earn XP
                                from completing missions.

                            </p>

                        </div>

                    }


                </div>

            </div>

        </div>

    </div>



    <!-- =====================================
         DAILY PROGRESS
         ===================================== -->

    <div class="card
        shadow-sm
        border-0
        mb-5">

        <div class="card-body p-4">


            <div class="d-flex
                justify-content-between
                align-items-center
                mb-2">

                <div>

                    <h5 class="fw-bold mb-1">
                        Today's Progress
                    </h5>

                    <span class="text-muted">

                        @completedToday of
                        @totalToday missions completed

                    </span>

                </div>


                <span class="badge
                    bg-success
                    fs-6">

                    @dailyPercent%

                </span>

            </div>


            <div class="progress"
                 style="height: 12px;">

                <div class="progress-bar
                    bg-success"
                     role="progressbar"
                     style="width: @dailyPercent%;">
                </div>

            </div>


        </div>

    </div>



    <!-- =====================================
         TODAY'S MISSIONS
         ===================================== -->

    <div class="d-flex
        justify-content-between
        align-items-center
        mb-3">

        <div>

            <h2 class="fw-bold mb-1">
                Today's Missions
            </h2>

            <p class="text-muted mb-0">

                @DateTime.Today.ToString(
                    "dddd, MMMM dd")

            </p>

        </div>

    </div>



    @if (!Model.Any())
    {

        <div class="card
            shadow-sm
            border-0">

            <div class="card-body
                text-center
                py-5">

                <div style="font-size: 55px;">
                    🌱
                </div>

                <h4 class="fw-bold mt-3">
                    No missions yet
                </h4>

                <p class="text-muted">

                    Start your day by creating
                    your first mission.

                </p>

                <a asp-action="Create"
                   class="btn btn-success">

                    + Create Mission

                </a>

            </div>

        </div>

    }
    else
    {

        <div class="row g-4">


            @foreach (var item in Model)
            {

                <div class="col-md-6">


                    <div class="card
                        shadow-sm
                        border-0
                        h-100">


                        <div class="card-body p-4">


                            <!-- Title -->
                            <div class="d-flex
                                justify-content-between
                                align-items-start
                                gap-3">


                                <h4 class="card-title mb-2">

                                    @if (item.IsCompleted)
                                    {
                                        <span>
                                            ✅
                                        </span>
                                    }

                                    @item.Title

                                </h4>


                                <!-- Difficulty -->
                                @if (item.Difficulty == "Easy")
                                {
                                    <span class="badge bg-success">

                                        Easy +10 XP

                                    </span>
                                }
                                else if (item.Difficulty == "Medium")
                                {
                                    <span class="badge
                                        bg-warning
                                        text-dark">

                                        Medium +20 XP

                                    </span>
                                }
                                else if (item.Difficulty == "Hard")
                                {
                                    <span class="badge bg-danger">

                                        Hard +30 XP

                                    </span>
                                }


                            </div>



                            <!-- Description -->
                            @if (!string.IsNullOrWhiteSpace(
                                item.Description))
                            {

                                <p class="text-muted mt-2">

                                    @item.Description

                                </p>

                            }



                            <!-- Time -->
                            <p class="small text-muted">

                                Created at
                                @item.CreatedDate.ToString(
                                    "h:mm tt")

                            </p>



                            <!-- Completed -->
                            @if (item.IsCompleted)
                            {

                                <div class="alert
                                    alert-success
                                    py-2">

                                    <strong>
                                        Mission Completed
                                    </strong>


                                    @if (item.CompletedDate.HasValue)
                                    {

                                        <br />

                                        <small>

                                            Completed at

                                            @item.CompletedDate.Value
                                            .ToString("h:mm tt")

                                        </small>

                                    }

                                </div>

                            }
                            else
                            {

                                <form asp-action="Complete"
                                      method="post"
                                      class="mb-3">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.MissionId" />

                                    <button type="submit"
                                            class="btn btn-success">

                                        ✓ Complete Mission

                                    </button>

                                </form>

                            }



                            <!-- Actions -->
                            <div class="d-flex gap-2">

                                @if (!item.IsCompleted)
                                {

                                    <a asp-action="Edit"
                                       asp-route-id="@item.MissionId"
                                       class="btn
                                        btn-outline-primary
                                        btn-sm">

                                        Edit

                                    </a>

                                }


                                <a asp-action="Details"
                                   asp-route-id="@item.MissionId"
                                   class="btn
                                    btn-outline-secondary
                                    btn-sm">

                                    Details

                                </a>


                                <a asp-action="Delete"
                                   asp-route-id="@item.MissionId"
                                   class="btn
                                    btn-outline-danger
                                    btn-sm">

                                    Delete

                                </a>

                            </div>


                        </div>

                    </div>

                </div>

            }


        </div>

    }

</div>