@model GrowQuest.Models.Mission

@{
    ViewData["Title"] = "Edit Mission";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h1 class="fw-bold mb-2">
                        ✏️ Edit Mission
                    </h1>

                    <p class="text-muted">
                        Update the details of your mission.
                    </p>

                    <hr />

                    <form asp-action="Edit">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger"></div>

                        <input type="hidden"
                               asp-for="MissionId" />

                        <div class="mb-3">

                            <label asp-for="Title"
                                   class="form-label fw-bold">
                                Mission Title
                            </label>

                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="Enter mission title" />

                            <span asp-validation-for="Title"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label fw-bold">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe your mission..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Difficulty"
                                   class="form-label fw-bold">
                                Difficulty
                            </label>

                            <select asp-for="Difficulty"
                                    class="form-select">

                                <option value="Easy">
                                    Easy - 10 XP
                                </option>

                                <option value="Medium">
                                    Medium - 20 XP
                                </option>

                                <option value="Hard">
                                    Hard - 30 XP
                                </option>

                            </select>

                            <span asp-validation-for="Difficulty"
                                  class="text-danger"></span>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-success">

                                Save Changes

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}