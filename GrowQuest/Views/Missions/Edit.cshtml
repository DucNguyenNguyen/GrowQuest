@model GrowQuest.Models.Mission

@{
    ViewData["Title"] = "Edit Mission";
}

<div class="growquest-page">

    <div class="create-mission-wrapper">

        <div class="text-center mb-4">

            <div class="page-icon">
                ✏️
            </div>

            <h1 class="fw-bold mb-2">
                Edit Mission
            </h1>

            <p class="text-muted mb-0">
                Update your mission details.
            </p>

        </div>


        <div class="card growquest-card">

            <div class="card-body p-4 p-md-5">

                <form asp-action="Edit">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <input type="hidden"
                           asp-for="MissionId" />


                    <!-- Title -->
                    <div class="mb-4">

                        <label asp-for="Title"
                               class="form-label fw-semibold">
                            Mission Title
                        </label>

                        <input asp-for="Title"
                               class="form-control growquest-input" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Description -->
                    <div class="mb-4">

                        <label asp-for="Description"
                               class="form-label fw-semibold">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control growquest-input"
                                  rows="4"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Mission Date -->
                    <div class="mb-4">

                        <label asp-for="MissionDate"
                               class="form-label fw-semibold">
                            Mission Date
                        </label>

                        <input asp-for="MissionDate"
                               type="date"
                               class="form-control growquest-input" />

                        <span asp-validation-for="MissionDate"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Difficulty -->
                    <div class="mb-4">

                        <label asp-for="Difficulty"
                               class="form-label fw-semibold">
                            Difficulty
                        </label>

                        <select asp-for="Difficulty"
                                class="form-select growquest-input">

                            <option value="Easy">
                                🟢 Easy — 10 XP
                            </option>

                            <option value="Medium">
                                🟡 Medium — 20 XP
                            </option>

                            <option value="Hard">
                                🔴 Hard — 30 XP
                            </option>

                        </select>

                        <span asp-validation-for="Difficulty"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="d-grid gap-2">

                        <button type="submit"
                                class="btn btn-success btn-lg">

                            Save Changes

                        </button>

                        <a asp-action="Index"
                           class="btn btn-light btn-lg">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}