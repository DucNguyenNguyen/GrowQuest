@model GrowQuest.Models.Mission

@{
    ViewData["Title"] = "Mission Details";

    string difficultyClass = "bg-success";
    int xpValue = 10;

    if (Model.Difficulty == "Medium")
    {
        difficultyClass = "bg-warning text-dark";
        xpValue = 20;
    }
    else if (Model.Difficulty == "Hard")
    {
        difficultyClass = "bg-danger";
        xpValue = 30;
    }
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start mb-3">

                        <div>

                            <h1 class="fw-bold mb-1">
                                📜 Mission Details
                            </h1>

                            <p class="text-muted mb-0">
                                View information about this mission.
                            </p>

                        </div>

                        <span class="badge @difficultyClass fs-6">

                            @Model.Difficulty
                            +@xpValue XP

                        </span>

                    </div>

                    <hr />

                    <div class="mb-4">

                        <h3>
                            @Model.Title
                        </h3>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="text-muted">
                                @Model.Description
                            </p>
                        }
                        else
                        {
                            <p class="text-muted">
                                No description provided.
                            </p>
                        }

                    </div>


                    <div class="row mb-4">

                        <div class="col-md-6">

                            <strong>
                                Difficulty
                            </strong>

                            <p>
                                @Model.Difficulty
                            </p>

                        </div>

                        <div class="col-md-6">

                            <strong>
                                Reward
                            </strong>

                            <p>
                                @xpValue XP
                            </p>

                        </div>

                        <div class="col-md-6">

                            <strong>
                                Created
                            </strong>

                            <p>
                                @Model.CreatedDate.ToString("MMM dd, yyyy h:mm tt")
                            </p>

                        </div>

                        <div class="col-md-6">

                            <strong>
                                Status
                            </strong>

                            @if (Model.IsCompleted)
                            {
                                <p class="text-success fw-bold">
                                    ✅ Completed
                                </p>
                            }
                            else
                            {
                                <p class="text-warning fw-bold">
                                    ⏳ In Progress
                                </p>
                            }

                        </div>

                    </div>


                    @if (Model.IsCompleted && Model.CompletedDate.HasValue)
                    {
                        <div class="alert alert-success">

                            <strong>
                                🎉 Mission completed!
                            </strong>

                            <br />

                            Completed on
                            @Model.CompletedDate.Value.ToString("MMM dd, yyyy h:mm tt")

                        </div>
                    }


                    <div class="d-flex gap-2">

                        @if (!Model.IsCompleted)
                        {
                            <a asp-action="Edit"
                               asp-route-id="@Model.MissionId"
                               class="btn btn-primary">

                                Edit Mission

                            </a>
                        }

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            Back to Missions

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>