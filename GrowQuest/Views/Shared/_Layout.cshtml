@using Microsoft.AspNetCore.Identity
@using GrowQuest.Models

@inject SignInManager<ApplicationUser> SignInManager


<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width,
    initial-scale=1.0" />

    <title>
        @ViewData["Title"] - GrowQuest
    </title>


    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/GrowQuest.styles.css"
          asp-append-version="true" />

</head>


<body class="d-flex flex-column min-vh-100">


    <header>

        <nav class="navbar
            navbar-expand-lg
            navbar-light
            bg-white
            border-bottom
            shadow-sm">

            <div class="container">


                <a class="navbar-brand
                    fw-bold
                    text-success"
                   asp-controller="Missions"
                   asp-action="Index">

                    🌱 GrowQuest

                </a>


                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#growQuestNavbar">

                    <span class="navbar-toggler-icon">
                    </span>

                </button>


                <div class="collapse navbar-collapse"
                     id="growQuestNavbar">


                    @if (SignInManager.IsSignedIn(User))
                    {

                        <ul class="navbar-nav me-auto">


                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Missions"
                                   asp-action="Index">

                                    Dashboard

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Missions"
                                   asp-action="Create">

                                    New Mission

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Missions"
                                   asp-action="Upcoming">

                                    Upcoming

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Missions"
                                   asp-action="History">

                                    History

                                </a>

                            </li>


                        </ul>


                        <div class="d-flex
                            align-items-center
                            gap-3">


                            <span class="text-muted small">

                                👤 @User.Identity?.Name

                            </span>


                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="m-0">


                                <button type="submit"
                                        class="btn
                                    btn-outline-secondary
                                    btn-sm">

                                    Logout

                                </button>


                            </form>


                        </div>

                    }
                    else
                    {

                        <div class="ms-auto
                            d-flex
                            gap-2">


                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn
                                btn-outline-success">

                                Login

                            </a>


                            <a asp-controller="Account"
                               asp-action="Register"
                               class="btn btn-success">

                                Register

                            </a>


                        </div>

                    }


                </div>

            </div>

        </nav>

    </header>


    <main role="main"
          class="flex-grow-1">

        @RenderBody()

    </main>


    <footer class="footer text-muted">

        <div class="container py-4">

            &copy; @DateTime.Now.Year
            - GrowQuest

            <span class="mx-2">
                |
            </span>

            Daily Mission Tracker

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false)


</body>

</html>